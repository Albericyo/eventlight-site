{% set pageTitle = title %}
{% set pageDescription = description %}
{% set pageCanonical = canonical or (site.url + page.url) %}
{% set pageType = ogType or "website" %}
{% set pageImage = site.url + (ogImage or site.ogImage) %}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  {% if robots %}
  <meta name="robots" content="{{ robots }}">
  {% else %}
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  {% endif %}
  <meta name="author" content="Event'Light">
  <meta name="geo.region" content="FR-80">
  <meta name="geo.placename" content="Amiens">
  <meta name="geo.position" content="{{ site.latitude }};{{ site.longitude }}">
  <meta name="ICBM" content="{{ site.latitude }}, {{ site.longitude }}">
  <meta name="theme-color" content="#d4d7d9" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#17191b" media="(prefers-color-scheme: dark)">
  <link rel="canonical" href="{{ pageCanonical }}">
  <link rel="alternate" hreflang="fr" href="{{ pageCanonical }}">
  <link rel="alternate" hreflang="x-default" href="{{ pageCanonical }}">
  <link rel="icon" href="/assets/logo/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/logo/favicon-48.png" sizes="48x48" type="image/png">
  <link rel="apple-touch-icon" href="/assets/logo/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:type" content="{{ pageType }}">
  <meta property="og:url" content="{{ pageCanonical }}">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:image" content="{{ pageImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Event'Light, son, lumière et vidéo mapping à Amiens">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ pageImage }}">

  <link rel="preload" href="/assets/fonts/sofia-sans-extra-condensed-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/sofia-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/site.css?v={{ build.version }}">
  <script>
    /* Thème choisi par le visiteur, appliqué avant le premier affichage. */
    document.documentElement.classList.add("js");
    try {
      var t = localStorage.getItem("el-salle");
      if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t);
    } catch (e) {}
  </script>

  {% include "schema.njk" %}
</head>
<body data-page="{{ page.url }}">
  <a class="skip" href="#contenu">Aller au contenu</a>

  {% include "partials/header.njk" %}

  <main id="contenu">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <p class="toast" id="toast" role="status" hidden></p>
  <script src="/assets/js/site.js?v={{ build.version }}" defer></script>
</body>
</html>
