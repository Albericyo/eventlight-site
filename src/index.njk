---
layout: layout.njk
title: "Location sono, lumière et vidéo mapping à Amiens | Event'Light"
description: "Event'Light : location et installation sono, lumière, effets et structures à Amiens. Mariages, anniversaires, CE, sport. Spécialiste du vidéo mapping dans la Somme."
---

<section class="hero">
  <div class="play-wrap">
    <button type="button" class="play-btn" id="hero-play" aria-label="Composer la lumière">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 3L20 12L4 21Z"/></svg>
    </button>
  </div>
  <h1>Composez la lumière</h1>
  <p class="lead">Particuliers et professionnels : mariage, anniversaire, comité d'entreprise, manifestation sportive. Sono, lumière, effets et <strong>vidéo mapping</strong> à Amiens — sur devis, clé en main ou en location.</p>
  <div class="hero-tracks">
    <span><i style="background:var(--cyan)"></i>Lumière</span>
    <span><i style="background:var(--red)"></i>Mapping</span>
    <span><i style="background:var(--yellow)"></i>Effets</span>
    <span><i style="background:var(--blue)"></i>Son</span>
  </div>
  <div class="hero-actions">
    <a class="btn solid" href="/devis/">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 3L20 12L4 21Z"/></svg>
      Demander un devis
    </a>
    <a class="btn ghost-dark" href="/location/">Catalogue location</a>
  </div>
</section>

<div class="wrap">
  <section class="section" id="composer" data-composer>
    <h2 class="section-title">Composez votre projet</h2>
    <p class="section-note">Choisissez le type d'événement et les pistes. On vous propose une formule de départ et des options — le devis reste personnalisé.</p>

    <fieldset class="composer-types">
      <legend class="mono composer-step">1 · Type d'événement</legend>
      <div class="composer-chips" role="radiogroup" aria-label="Type d'événement">
        {% for t in business.eventTypes %}
        <label class="composer-chip">
          <input type="radio" name="composer-type" value="{{ t.id }}"{% if loop.first %} checked{% endif %}>
          <span>{{ t.label }}</span>
        </label>
        {% endfor %}
      </div>
    </fieldset>

    <div class="composer-layout">
      <div class="composer-side">
        <p class="mono composer-step">2 · Pistes à activer</p>
        <div class="tracks" data-composer-tracks>
          {% for track in business.tracks %}
          <div class="track-row{% if track.id == 'lumiere' or track.id == 'son' or track.id == 'effets' %} on{% endif %}">
            <label>
              <input type="checkbox" name="composer-track" value="{{ track.id }}"{% if track.id == 'lumiere' or track.id == 'son' or track.id == 'effets' %} checked{% endif %}>
              <span class="switch"></span>
            </label>
            <span class="track-name">{{ track.label }}</span>
            <span class="track-swatch" style="background:{{ track.swatch }}"></span>
          </div>
          {% endfor %}
        </div>
      </div>

      <aside class="composer-summary" aria-live="polite">
        <p class="mono composer-step">Orientation</p>
        <h3 class="composer-summary-title" data-composer-title>Formule Mariage</h3>
        <p class="composer-summary-pack" data-composer-pack>Pack Standard — à partir de 799 €</p>
        <p class="composer-summary-tracks" data-composer-pistes>Pistes : lumière, son, effets</p>
        <ul class="composer-addons" data-composer-addons></ul>
        <p class="composer-summary-hint" data-composer-hint></p>
        <p class="composer-summary-note mono">{{ business.pricingNote }}</p>
        <p class="composer-summary-tva mono">{{ site.tva }}</p>
        <div class="composer-actions">
          <a class="btn solid" data-composer-devis href="/devis/?type=Mariage&amp;pistes=lumiere,son,effets">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 3L20 12L4 21Z"/></svg>
            Continuer vers le devis
          </a>
          <a class="btn" data-composer-secondary href="/nos-formules/mariage/">Voir la formule</a>
        </div>
      </aside>
    </div>

    <script type="application/json" id="composer-data">{{ { eventTypes: business.eventTypes, tracks: business.tracks, addons: business.addons, formules: formules.pages, pricingNote: business.pricingNote, tvaNote: site.tva } | jsonLd | safe }}</script>
  </section>

  <section class="section">
    <h2 class="section-title">Nos formules</h2>
    <p class="section-note">Quatre formules pour particuliers et structures pro. Packs Essentiel → Standard / Soirée → Premium, options hors pack au devis.</p>
    <ul class="cards">
      {% for f in formules.pages %}
      <li>
        <a class="card-link" href="/nos-formules/{{ f.slug }}/">
          <div class="frame {{ f.slug | frameClass }}" data-duration="{{ 120 + loop.index0 * 20 }}">
            <span class="badge mono">CH. {% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
            <div class="controls"><span class="time mono">0:00</span><div class="bar"><div class="playhead"></div></div></div>
          </div>
          <div class="cap">{{ f.titre }}<span class="date">À partir de {{ f.packs[0].prix }}</span></div>
        </a>
      </li>
      {% endfor %}
    </ul>
  </section>

  <section class="section">
    <h2 class="section-title">Location de matériel</h2>
    <p class="section-note">Projecteurs robotisés, sonorisation, machines à effets, structures. {{ site.livraison }}.</p>
    <ul class="cards">
      {% for c in categories %}
      {% set first = produits | firstOfCat(c.nom) %}
      {% set thumb = first.slug | cover("location") if first else "" %}
      <li>
        <a class="card-link" href="/location/{{ c.slug }}/">
          <div class="frame {{ loop.index0 | folioFrame }}{% if thumb %} has-photo{% endif %}" data-duration="{{ 90 + loop.index0 * 15 }}">
            {% if thumb %}<img src="{{ thumb }}" alt="{{ c.nom }} — location Event'Light Amiens" width="640" height="400" loading="lazy">{% endif %}
            <span class="badge mono">CAT</span>
            <div class="controls"><span class="time mono">0:00</span><div class="bar"><div class="playhead"></div></div></div>
          </div>
          <div class="cap">{{ c.nom }}<span class="date">{{ c.h1 }}</span></div>
        </a>
      </li>
      {% endfor %}
    </ul>
    <p style="margin-top:24px"><a class="btn" href="/location/">Ouvrir le catalogue</a></p>
  </section>

  <section class="section">
    <h2 class="section-title">Portfolio</h2>
    <p class="section-note">Mappings, mariages, galas — réalisations Event'Light.</p>
    <div class="polaroids">
      {% for projet in portfolio %}
      {% if loop.index <= 6 %}
      {% set cover = projet.slug | cover("portfolio") %}
      <a class="clip" href="/portfolio/{{ projet.slug }}/">
        <div class="frame {{ loop.index0 | folioFrame }}{% if cover %} has-photo{% endif %}" data-duration="{{ 100 + loop.index0 * 30 }}">
          {% if cover %}
          <img src="{{ cover }}" alt="{{ projet.titre }} — {{ projet.annee }}, Event'Light" width="800" height="500" loading="lazy">
          {% endif %}
          <span class="badge mono">{{ projet.type }}</span>
          <div class="controls"><span class="time mono">0:00</span><div class="bar"><div class="playhead"></div></div></div>
        </div>
        <div class="cap">{{ projet.titre }}<span class="date">{{ projet.annee }}</span></div>
      </a>
      {% endif %}
      {% endfor %}
    </div>
    <p style="margin-top:24px"><a class="btn" href="/portfolio/">Voir le portfolio</a></p>
  </section>

  <section class="section">
    <h2 class="section-title">Questions fréquentes</h2>
    <dl class="faq">
      {% for item in faq %}
      <div>
        <dt>{{ item.q }}</dt>
        <dd>{{ item.a }}</dd>
      </div>
      {% endfor %}
    </dl>
  </section>
</div>
