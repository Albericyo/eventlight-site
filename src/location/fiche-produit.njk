---
layout: layout.njk
pagination:
  data: produits
  size: 1
  alias: produit
  addAllPagesToCollections: true
permalink: "/location/{{ produit.slug }}/"
---
{% from "macros.njk" import item, band with context %}
{% set shots = produit.slug | media("location") %}
{% set principale = produit.slug | coverProduit %}
{% set yt = produit.slug | youtubeId %}
{% set prix = produit.prix | prixDetail %}
{% set catSlug = produit.categorie | categorieSlug(categories) %}
{% set altPhoto = produit.nom + ", en location à Amiens chez Event'Light" %}
<div class="wrap">
  <div class="page-head">
    {% include "breadcrumbs.njk" %}
  </div>

  <div class="product">
    <div class="product-media">
      <div class="vitrine" data-photo>
        {% if principale %}{% img principale, altPhoto, "(min-width: 56em) 45vw, 100vw", "eager" %}{% elif produit.slug | aPicto %}{% picto produit.slug, produit.nom %}{% else %}{% picto catSlug, produit.nom %}{% endif %}
      </div>
      {% if shots | length > 1 %}
      <div class="thumbs">
        {% for m in shots %}
        <button type="button" data-vignette="{{ m.base }}-{{ m.largeurs | last }}.webp" data-fond="{{ m.fond }}" aria-pressed="{% if m.base == principale.base %}true{% else %}false{% endif %}" aria-label="Photo {{ loop.index }} sur {{ shots | length }}">
          <span class="vitrine"><img src="{{ m.base }}-{{ m.largeurs | first }}.webp" width="{{ m.w }}" height="{{ m.h }}" alt="" loading="lazy" decoding="async" data-fond="{{ m.fond }}"></span>
        </button>
        {% endfor %}
      </div>
      {% endif %}
    </div>

    <div class="product-body">
      <div class="tags"><a class="tag" href="/location/{{ catSlug }}/">{{ produit.categorie }}</a></div>
      <h1>Location {{ produit.nom }} à Amiens</h1>
      <p class="price"><b>{{ prix.montant }}&nbsp;{{ prix.unite }}</b>{% if prix.note %}<small>{{ prix.note }}</small>{% endif %}<small>Même tarif pour le week-end</small></p>
      <p class="lede">{{ produit.description | typo }}</p>
      <div class="actions">
        <button class="btn btn-plein add" type="button" data-add="{{ produit.slug }}" data-nom="{{ produit.nom }}" data-prix="{{ produit.prix }}" data-label-in="Dans ma sélection">Ajouter à ma sélection</button>
        <a class="btn" href="/devis/?type={{ "Location de matériel" | urlencode }}">Demander un devis</a>
      </div>
      {% if produit.details %}
      <div class="stack">
        <h2 class="sr">Caractéristiques</h2>
        <ul class="checks">
          {% for d in produit.details %}<li>{{ d | typo }}</li>{% endfor %}
        </ul>
      </div>
      {% endif %}
      {% if produit.usages.length %}
      <div class="stack">
        <h2 style="font: 600 1rem/1.3 var(--texte)">On le sort souvent pour</h2>
        <div class="tags">
          {% for u in produit.usages %}
          <a class="tag" href="/nos-formules/{{ u }}/">{{ u | usageLabel }}</a>
          {% endfor %}
        </div>
      </div>
      {% endif %}
      <p class="note">{{ site.livraison | typo }}. Tous les câbles nécessaires peuvent être fournis.</p>
    </div>
  </div>
</div>

{% if yt %}
<section class="section">
  <div class="wrap split">
    <div class="split-head">
      <h2>En démonstration</h2>
      <p>La vidéo est hébergée par YouTube : elle ne se charge qu'au clic.</p>
    </div>
    <div class="split-body">
      <div class="video" data-video="{{ yt }}" data-titre="Démonstration, {{ produit.nom }}">
        {% set poster = (shots | avecFond("sombre") | first) or (shots | avecFond("image") | first) %}
        {% if poster %}<img src="{{ poster.base }}-{{ poster.largeurs | last }}.webp" width="{{ poster.w }}" height="{{ poster.h }}" alt="" loading="lazy" decoding="async">{% else %}{% include "logo/signe-trait.svg" %}{% endif %}
        <a class="video-play" href="https://www.youtube.com/watch?v={{ yt }}" rel="noopener">Lire la démonstration</a>
      </div>
    </div>
  </div>
</section>
{% endif %}

{% set autres = produits | relatedProduits(produit) %}
{% if autres.length %}
<section class="section">
  <div class="wrap split">
    <div class="split-head">
      <h2>Dans la même catégorie</h2>
      <p><a class="btn" href="/location/">Tout le catalogue</a></p>
    </div>
    <div class="split-body">
      <ul class="shelf">
        {% for p in autres %}{{ item(p) }}{% endfor %}
      </ul>
    </div>
  </div>
</section>
{% endif %}
