---
layout: layout.njk
pagination:
  data: produits
  size: 1
  alias: produit
  addAllPagesToCollections: true
permalink: "/location/{{ produit.slug }}/"
---
<div class="wrap">
  {% include "breadcrumbs.njk" %}

  <div class="product-sheet">
    {% set shots = produit.slug | gallery("location") %}
    <div class="preview product-monitor">
      {% if shots.length %}
      <img class="product-photo" src="{{ shots[0] }}" alt="{{ produit.nom }} en location à Amiens — Event'Light" width="900" height="675">
      {% else %}
      <div class="layer2 on" data-layer="lumiere"></div>
      <div class="layer2 on" data-layer="mapping"></div>
      {% endif %}
      <span class="monitor-badge mono">CLIP</span>
      <span class="readout mono">{{ produit.categorie | upper }}</span>
    </div>
    <div>
      <p class="page-kicker mono">FICHE MATÉRIEL</p>
      <h1>Location {{ produit.nom }} à Amiens</h1>
      <p class="prix">{{ produit.prix }}</p>
      <p>{{ produit.description }}</p>
      {% if produit.details %}
      <h2 class="section-title" style="margin-top:24px">Caractéristiques</h2>
      <ul class="specs">
        {% for d in produit.details %}
        <li>{{ d }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% if produit.usages.length %}
      <div class="chip-row">
        {% for u in produit.usages %}
        <a class="chip" href="/nos-formules/{{ u }}/">{{ u | usageLabel }}</a>
        {% endfor %}
      </div>
      {% endif %}
      <p class="section-note">{{ site.livraison }}. Tarif journalier identique le week-end.</p>
      <a class="btn solid" href="/devis/">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 3L20 12L4 21Z"/></svg>
        Louer {{ produit.nom }}
      </a>
      <p style="margin-top:18px"><a href="/location/">← Retour au catalogue</a></p>
    </div>
  </div>

  {% set autres = produits | relatedProduits(produit) %}
  {% if autres.length %}
  <section class="section">
    <h2 class="section-title">Dans la même catégorie</h2>
    <ul class="catalogue-liste">
      {% for p in autres %}
      <li>
        <a href="/location/{{ p.slug }}/">{{ p.nom }}</a>
        <span class="prix-tag">{{ p.prix }}</span>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}
</div>
