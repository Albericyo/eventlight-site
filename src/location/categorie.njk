---
layout: layout.njk
pagination:
  data: categories
  size: 1
  alias: categorie
  addAllPagesToCollections: true
permalink: "/location/{{ categorie.slug }}/"
---
<div class="wrap">
  <header class="page-head">
    {% include "breadcrumbs.njk" %}
    <p class="page-kicker mono">LOCATION · AMIENS</p>
    <h1>{{ categorie.h1 }}</h1>
    <p class="lede">{{ categorie.intro }} {{ site.livraison }}.</p>
  </header>

  <ul class="catalogue-liste">
    {% for p in produits %}
      {% if p.categorie == categorie.nom %}
      {% set thumb = p.slug | cover("location") %}
      <li>
        {% if thumb %}
        <img class="thumb" src="{{ thumb }}" alt="{{ p.nom }}" width="176" height="132" loading="lazy">
        {% else %}
        <span class="thumb" aria-hidden="true"></span>
        {% endif %}
        <div>
          <a href="/location/{{ p.slug }}/">{{ p.nom }}</a>
          <p>{{ p.description }}</p>
        </div>
        <span class="prix-tag">{{ p.prix }}</span>
      </li>
      {% endif %}
    {% endfor %}
  </ul>

  <p style="margin-top:28px">
    <a href="/location/">← Catalogue complet</a>
    ·
    <a class="btn solid" href="/devis/">Devis location</a>
  </p>
</div>
