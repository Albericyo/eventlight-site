---
layout: layout.njk
pagination:
  data: categories
  size: 1
  alias: categorie
  addAllPagesToCollections: true
permalink: "/location/{{ categorie.slug }}/"
---
{% from "macros.njk" import item, band with context %}
<div class="wrap">
  <header class="page-head">
    {% include "breadcrumbs.njk" %}
    <h1>{{ categorie.h1 }}</h1>
    <p class="lede">{{ categorie.intro | typo }}</p>
    <p class="note">{{ site.livraison | typo }}. Tarif journalier identique le week-end.</p>
  </header>

  <ul class="shelf">
    {% for p in produits | deCategorie(categorie.nom) %}{{ item(p, 2) }}{% endfor %}
  </ul>
</div>

<section class="section">
  <div class="wrap split">
    <div class="split-head">
      <h2>Le reste du catalogue</h2>
    </div>
    <div class="split-body">
      <ul class="cats">
        {% for c in categories %}
        {% if c.slug != categorie.slug %}
        {% set liste = produits | deCategorie(c.nom) %}
        <li>
          <a class="cat" href="/location/{{ c.slug }}/">
            <span class="vitrine">{% picto c.slug %}</span>
            <b>{{ c.nom }}</b>
            <span>{{ liste | length }} références, dès {{ liste | prixMin }}&nbsp;€ par jour</span>
          </a>
        </li>
        {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

{% set lienDevis = "/devis/?type=" + ("Location de matériel" | urlencode) %}
{{ band("Réserver ce matériel", "Ajoutez ce qu'il vous faut à votre sélection, puis envoyez la demande avec vos dates.", lienDevis, "Demander un devis de location") }}
