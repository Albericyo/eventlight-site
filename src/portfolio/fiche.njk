---
layout: layout.njk
pagination:
  data: portfolio
  size: 1
  alias: projet
  addAllPagesToCollections: true
permalink: "/portfolio/{{ projet.slug }}/"
---
<div class="wrap">
  <header class="page-head">
    {% include "breadcrumbs.njk" %}
    <p class="page-kicker mono">{{ projet.type }} · {{ projet.annee }}</p>
    <h1>{{ projet.titre }}</h1>
    <p class="lede">{{ projet.sousTitre }}</p>
  </header>

  <div class="legal-content">
    {% if projet.production %}<p><strong>Production :</strong> {{ projet.production }}</p>{% endif %}
    {% if projet.credits %}
    <ul class="specs">
      {% for c in projet.credits %}
      <li>{{ c }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if projet.logiciel %}<p><strong>Logiciel :</strong> {{ projet.logiciel }}</p>{% endif %}
    {% if projet.technologie %}<p><strong>Technologie :</strong> {{ projet.technologie }}</p>{% endif %}
    {% if projet.projet %}
    <h2>Projet</h2>
    <p>{{ projet.projet }}</p>
    {% elif projet.resume %}
    <p>{{ projet.resume }}</p>
    {% endif %}
  </div>

  <p style="margin-top:28px">
    <a class="btn solid" href="/devis/">Parler d'un projet similaire à Amiens</a>
  </p>
  <p style="margin-top:16px"><a href="/portfolio/">← Retour au portfolio</a></p>
</div>
