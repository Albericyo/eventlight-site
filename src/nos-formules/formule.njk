---
layout: layout.njk
pagination:
  data: formules.pages
  size: 1
  alias: formule
  addAllPagesToCollections: true
permalink: "/nos-formules/{{ formule.slug }}/"
---
{% from "macros.njk" import item, work, band with context %}
<div class="wrap">
  <header class="page-head">
    {% include "breadcrumbs.njk" %}
    <h1>{{ formule.h1 }}</h1>
    <p class="lede">{{ formule.description | typo }}</p>
  </header>

  <div class="packs">
    {% for pack in formule.packs %}
    {% set precedent = (formule.packs[loop.index0 - 1].items if not loop.first else []) %}
    <article class="pack{% if pack.featured %} lit{% endif %}">
      <div class="pack-head">
        <h2>{{ pack.nom }}</h2>
        {% if pack.featured %}<span class="tag tag-trait">Recommandé</span>{% endif %}
      </div>
      <p class="price"><small>à partir de</small><b>{{ pack.prix | typo }}</b></p>
      {% set couchesPack = pack.items | couches %}{% set titrePlan = pack.nom + " : schéma de l'installation" %}
      {% plan couchesPack, titrePlan %}
      <ul class="checks">
        {% for it in pack.items %}
        <li{% if (precedent | length) and not (it in precedent) %} class="plus"{% endif %}>{{ it }}</li>
        {% endfor %}
      </ul>
      <a class="btn{% if pack.featured %} btn-plein{% endif %}" href="/devis/?type={{ formule.devisType | urlencode }}&amp;pack={{ pack.nom | urlencode }}">Demander ce pack</a>
    </article>
    {% endfor %}
  </div>
  {% if formule.packs | length > 1 %}<p class="note" style="margin-top: var(--e-4)">Les lignes en gras sont celles qui s'ajoutent au pack précédent. {{ site.tva }}.</p>{% endif %}
</div>

<section class="section">
  <div class="wrap split">
    <div class="split-head">
      <h2>Compris, en option</h2>
      <p>{{ formules.personnalisation | typo }}</p>
    </div>
    <div class="split-body cols-2">
      <div class="stack">
        <h3>Dans chaque pack</h3>
        <ul class="checks">
          {% for it in formules.inclusBase %}<li class="plus">{{ it }}</li>{% endfor %}
        </ul>
      </div>
      <div class="stack">
        <h3>En option, au devis</h3>
        <ul class="checks">
          {% for it in formule.optionsHorsPack %}<li>{{ it | typo }}</li>{% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

{% set vus = [] %}
{% for projet in portfolio %}{% if projet.type in (formule.typesPortfolio or []) %}{% set _ = vus.push(projet) %}{% endif %}{% endfor %}
{% if vus | length %}
<section class="section">
  <div class="wrap split">
    <div class="split-head">
      <h2>Déjà fait</h2>
    </div>
    <div class="split-body">
      <div class="works">
        {% for projet in vus %}{{ work(projet, false) }}{% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

<section class="section">
  <div class="wrap split">
    <div class="split-head">
      <h2>Le matériel associé</h2>
      <p>Ces références se louent aussi seules, à la journée.</p>
      <p><a class="btn" href="/location/">Tout le catalogue</a></p>
    </div>
    <div class="split-body">
      <ul class="shelf">
        {% for p in (produits | avecUsage(formule.usage)).slice(0, 6) %}{{ item(p) }}{% endfor %}
      </ul>
    </div>
  </div>
</section>

{% set lienDevis = "/devis/?type=" + (formule.devisType | urlencode) %}
{{ band("Vérifier une date", "Dites-nous la date, le lieu et le nombre d'invités. Le devis est gratuit et valable 30 jours.", lienDevis, "Demander un devis") }}
